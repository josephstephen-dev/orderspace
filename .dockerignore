# Dependencies (re-installed during Docker build)
node_modules/
.pnpm-store/

# Build output (re-compiled during Docker build)
dist/
build/

# NOTE: src/generated/ is NOT ignored. The generated Prisma client is committed
# on purpose and must stay in the build context.

# Git
.git/
.gitignore

# Environment files: never bake secrets into images
.env
.env.*
!.env.example

# IDE & OS
.vscode/
.idea/
.DS_Store

# Logs
*.log
logs/

# Test coverage
coverage/
.nyc_output/

# CI
.github/

# AI tooling and agent skills (not needed at runtime)
.agents/
.claude/
CLAUDE.md
skills-lock.json

# Docker files themselves
Dockerfile
docker-compose*.yml
.dockerignore

# Docs
README.md
CONTRIBUTING.md
SECURITY.md
CODE_OF_CONDUCT.md
LICENSE

# Temp
.temp/
.tmp/