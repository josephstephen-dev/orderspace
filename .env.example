# =============================================================================
# Orderspace environment configuration
# Copy this file to .env and fill in the values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=orderspace
PORT=3000
# development | production | test
NODE_ENV=development
# Comma-separated list of allowed browser origins (your frontend URLs)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# -----------------------------------------------------------------------------
# Database (matches docker-compose.yml)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/orderspace

# Optional: override the Docker Compose database credentials
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=orderspace

# -----------------------------------------------------------------------------
# JWT
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The two secrets MUST be different from each other.
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Rate limiting
# THROTTLE_LIMIT requests allowed per THROTTLE_TTL seconds
# -----------------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# -----------------------------------------------------------------------------
# UploadThing (file uploads) - https://uploadthing.com
# -----------------------------------------------------------------------------
UPLOADTHING_TOKEN=

# -----------------------------------------------------------------------------
# Resend (transactional email) - https://resend.com
# For quick local testing you can use onboarding@resend.dev as the sender.
# For real use, verify your own domain in Resend first.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Orderspace